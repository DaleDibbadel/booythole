#!/bin/bash
# Starts Tails' bundled Tor Browser (Flatpak org.boum.tails.TorBrowser) inside its bubblewrap sandbox, using the gateway Tor (SOCKS 9150 + filtered control 9051).
# Arguments (v0.9): Tails' menu entry runs "tor-browser @@u %u @@" ("@@u ... @@" is Flatpak's file-forwarding syntax: the desktop-entry field code %u expands to nothing
# or to the URL(s) being opened). Tails' original launcher passes them to `flatpak run --file-forwarding`, which consumes the delimiters. v0.5-0.8 of this shim omitted that
# flag, so the delimiters reached Firefox as two literal "URLs" (file:///usr/local/lib/tor-browser/@@u, https://u/). Here the delimiters are consumed explicitly: URLs are passed
# as plain arguments (no document portal needed, none exists in this container); anything that is not a URL is a local path and is passed through --file-forwarding.
# Like Tails' tails-run-tor-browser-in-flatpak, options are refused so only URLs/paths can be passed; a stray "@@u", "@@" or field code never becomes a target.
URLS=(); FILES=()
for a in "$@"; do
  case "$a" in
    -*) echo "Error: option '$a' not supported" >&2; exit 1;;
    @@u|@@|@@f|@@F|%u|%U|%f|%F|"") ;;
    [A-Za-z]*://*|about:*|data:*) URLS+=("$a");;
    *) FILES+=("$a");;
  esac
done
FF=(); [ ${#FILES[@]} -gt 0 ] && FF=(--file-forwarding)
ARGS=("${URLS[@]}"); [ ${#FILES[@]} -gt 0 ] && ARGS+=(@@u "${FILES[@]}" @@)
export FLATPAK_FANCY_OUTPUT=0 XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg-run} DISPLAY=${DISPLAY:-:1}
# One writable profile, one session: custom_startup.sh holds an exclusive flock on $HOME/.kb-profile.lock for the whole session (persistent profiles live on a
# shared host directory). If another session already holds it, refuse to start a second browser on the same profile.
if [ -e /tmp/kb-profile-busy ]; then
  python3 -I - <<'PY'
import gi; gi.require_version("Gtk","3.0")
from gi.repository import Gtk
d=Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR,buttons=Gtk.ButtonsType.CLOSE,text="Profile already in use")
d.format_secondary_text("Another Tails session is using this saved profile. Close it first, or launch this workspace with the persistent profile Disabled."); d.run()
PY
  exit 1
fi
# A Firefox lock left by a crashed earlier session can only be stale when we hold the profile flock and no browser runs in this container.
if ! pgrep -f 'firefox.real' >/dev/null 2>&1; then rm -f "$HOME/.tor-browser/profile.default/lock" "$HOME/.tor-browser/profile.default/.parentlock" 2>/dev/null; fi
# flatpak creates an EMPTY ~/.tor-browser as a bind source on first sandbox use, and Tails' generator refuses to run when that directory exists: remove it only if empty
[ -d "$HOME/.tor-browser/profile.default" ] || { rmdir "$HOME/.tor-browser" 2>/dev/null; /usr/local/lib/generate-tor-browser-profile; }
# Tails' profile template links places.sqlite to /home/amnesia/.mozilla/firefox/bookmarks/ (Tails' persistent-bookmarks path). That path does not exist
# here, so Firefox reported the bookmarks/history file as unusable. Use a session-private store inside the (disposable) home instead; nothing is deleted.
BM="$HOME/.mozilla/firefox/bookmarks"; P="$HOME/.tor-browser/profile.default/places.sqlite"
mkdir -p -m 700 "$BM"
if [ -L "$P" ] && [ "$(readlink "$P")" = "/home/amnesia/.mozilla/firefox/bookmarks/places.sqlite" ]; then ln -sfn "$BM/places.sqlite" "$P"; fi
RT=/var/lib/flatpak-tails/runtime/org.boum.tails.Platform/x86_64/stable/active/files
# Tails fills the pseudo-runtime with an overlay of /usr at boot (needs root); unprivileged equivalent: an outer user+mount namespace with /usr bind-mounted onto it
export FLATPAK_BWRAP=/usr/local/bin/kb-bwrap
exec bwrap --dev-bind / / --bind /usr "$RT" -- flatpak --installation=tails run "${FF[@]}" --command=tor-browser \
  --env=TOR_SKIP_LAUNCH=1 \
  --env=TOR_NO_DISPLAY_NETWORK_SETTINGS=1 \
  org.boum.tails.TorBrowser "${ARGS[@]}"
