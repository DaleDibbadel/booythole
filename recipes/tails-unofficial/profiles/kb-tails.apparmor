#include <tunables/global>
# kb-tails: docker-default derivative for the UNOFFICIAL Tails container. Differences from docker-default: `userns,` and `mount,`/`pivot_root,`
# (so bubblewrap can build its nested sandbox in a user namespace); everything else is as docker-default.
profile kb-tails flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  userns,
  mount,
  pivot_root,
  # Docker-default hardening kept
  deny @{PROC}/* w,
  # /proc/sys writes denied except the per-user-namespace sysctls under /proc/sys/user (bubblewrap sets its own namespace's limit)
  deny @{PROC}/sys/[^u]** w,
  deny @{PROC}/sys/u[^s]** w,
  deny @{PROC}/sys/us[^e]** w,
  deny @{PROC}/sys/use[^r]** w,
  # Kasm's group-level volume mapping (All Users) adds /data (per-user persistent) and /share (shared by every session) to EVERY workspace; this workspace
  # must not read or write either, so the Tails-style disposable session cannot leak to or persist in them
  deny /data/** rwklmx,
  deny /share/** rwklmx,
  deny /data/ rwklmx,
  deny /share/ rwklmx,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  # v0.5: the kb-tails Docker runtime (host/kb-runc) empties Docker's maskedPaths/readonlyPaths for this confined container so the browser sandbox can have its own
  # PID namespace and procfs. These rules are the compensating control: every path Docker's default would have masked or made read-only stays unreadable/unwritable.
  deny @{PROC}/{kmsg,mem,kmem,keys,timer_list,timer_stats,sched_debug,latency_stats} rwklx,
  deny @{PROC}/acpi/ rwklx,
  deny @{PROC}/acpi/** rwklx,
  deny @{PROC}/scsi/ rwklx,
  deny @{PROC}/scsi/** rwklx,
  deny @{PROC}/{bus,fs,irq}/** wklx,
  deny /sys/firmware/ rwklx,
  deny /sys/kernel/security/ rwklx,
  deny /sys/devices/virtual/powercap/ rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  # no ptrace between processes of this container (the desktop has no debugger use); reading peer /proc entries stays allowed
  ptrace (read,readby) peer=kb-tails,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=kb-tails,
}
