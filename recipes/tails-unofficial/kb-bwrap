#!/usr/bin/python3
"""kbtails bwrap shim (FLATPAK_BWRAP) v2.
v0.4 had to rewrite flatpak's bubblewrap arguments (bind the container /proc, drop --unshare-pid and --disable-userns) because Docker's masked
/proc paths make a fresh procfs impossible for a nested user namespace. v0.5 runs under the Docker runtime "kb-tails" (host/kb-runc), which empties
maskedPaths/readonlyPaths for this confined container only, so flatpak's ORIGINAL arguments work unchanged: own user, mount, PID and IPC namespace,
fresh procfs, --disable-userns. This shim now only VERIFIES that: if /proc still has Docker's over-mounts it refuses to start the sandbox (fail closed)
unless KB_ALLOW_DEGRADED=1 is set (never set by the workspace). It never rewrites arguments."""
import os, sys
REAL = "/usr/bin/bwrap"
def proc_masked():
    try:
        for ln in open("/proc/self/mountinfo"):
            mp = ln.split()[4]
            if mp.startswith("/proc/"): return True
    except Exception: return True
    return False
if proc_masked() and os.environ.get("KB_ALLOW_DEGRADED") != "1":
    sys.stderr.write("kb-bwrap: /proc is masked (runtime kb-tails not applied); refusing to start the browser sandbox without its PID namespace\n"); sys.exit(125)
os.execv(REAL, [REAL] + sys.argv[1:])
